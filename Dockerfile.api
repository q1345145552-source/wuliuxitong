# Node 钉死小版本（2026-10-23 安全审查 S2）：deploy.sh 构建不拉新镜像，写 22-alpine 会一直用服务器上缓存的旧补丁；升级时两个 Dockerfile（web 有 builder / runner 两处 FROM）和 .github/workflows/ci.yml 三处 node-version 一起改
FROM node:22.23.4-alpine

RUN apk add --no-cache openssl

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
RUN npm install -g tsx@4.19.2

COPY packages/shared-types ./packages/shared-types
COPY apps/api ./apps/api

RUN npx prisma generate --schema=apps/api/prisma/schema.prisma

# TypeScript 类型检查 — 待 @types/node 就绪后启用
# RUN npx tsc --noEmit --project apps/api/tsconfig.json

ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

USER node

CMD ["tsx", "apps/api/src/main.ts"]
