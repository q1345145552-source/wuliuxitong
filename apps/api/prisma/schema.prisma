model WhrConsolidationPlan {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  planNo        String   @unique @map("plan_no") // WHR + 7位数字
  warehouse     String   @default("义乌") @map("warehouse") // 义乌 | 深圳 | 广州
  containerType String   @default("40HQ") @map("container_type") // 40HQ | 40GP | 20GP
  destinationTh String   @map("destination_th") @db.Text
  totalVolumeM3 Decimal  @default(68) @map("total_volume_m3") @db.Decimal(10, 2)
  status        String   @default("planning") // planning | collecting | loading | shipped | completed | cancelled
  createdBy     String   @map("created_by")
  creatorName   String   @map("creator_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customers WhrConsolidationPlanCustomer[]

  @@index([companyId, status])
  @@index([companyId, planNo])
  @@map("whr_consolidation_plans")
}

model WhrConsolidationPlanCustomer {
  id                  String   @id @default(cuid())
  planId              String   @map("plan_id")
  companyId           String   @map("company_id")
  clientId            String   @map("client_id")
  unitPriceNormal     Decimal  @map("unit_price_normal") @db.Decimal(10, 2) // 普货单价 元/方
  unitPriceInspection Decimal  @map("unit_price_inspection") @db.Decimal(10, 2) // 商检单价 元/方
  unitPriceSensitive  Decimal  @map("unit_price_sensitive") @db.Decimal(10, 2) // 敏感单价 元/方
  totalVolumeM3       Decimal  @default(0) @map("total_volume_m3") @db.Decimal(10, 3)
  totalFee            Decimal? @map("total_fee") @db.Decimal(12, 2)
  deliveryAddress     String?  @map("delivery_address") @db.Text

  // 汇总
  totalPrealerts Int @default(0) @map("total_prealerts")
  totalPackages  Int @default(0) @map("total_packages")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan      WhrConsolidationPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  client    User                       @relation(fields: [clientId], references: [id])
  prealerts WhrConsolidationPrealert[]

  // 2026-09-02 老板拍板：同一个柜 + 同一个客户只许一行（数据库级铁门，代码锁是第一道防线）
  @@unique([planId, clientId])
  @@index([companyId, clientId])
  @@index([companyId, planId])
  @@map("whr_consolidation_plan_customers")
}

model WhrConsolidationPrealert {
  id         String  @id @default(cuid())
  customerId String  @map("customer_id")
  companyId  String  @map("company_id")
  trackingNo String  @unique @map("tracking_no") // WHRP + 4位数字
  expressNo  String? @map("express_no")
  mark       String  @map("mark")

  // 预报单状态流转: pending → received_pending_payment → payment_submitted → paid → loading → shipped → thailand_received
  // 任意节点可 → cancelled
  status     String    @default("pending") // pending | received_pending_payment | payment_submitted | paid | loading | shipped | thailand_received | cancelled
  receivedAt DateTime? @map("received_at")

  // 仓库签收
  signedAt               DateTime? @map("signed_at")
  warehouseReceiptProofs Json      @default("[]") @map("warehouse_receipt_proofs") @db.JsonB

  // 付款凭证（多张，JSON 数组）
  paymentProofs          Json      @default("[]") @map("payment_proofs") @db.JsonB
  paymentProofUploadedAt DateTime? @map("payment_proof_uploaded_at")
  totalFee               Decimal?  @map("total_fee") @db.Decimal(12, 2)

  // 管理员审核
  paymentReviewedAt   DateTime? @map("payment_reviewed_at")
  paymentReviewedBy   String?   @map("payment_reviewed_by")
  paymentRejectReason String?   @map("payment_reject_reason") @db.Text

  // 泰国签收单
  thailandReceiptProofs Json      @default("[]") @map("thailand_receipt_proofs") @db.JsonB
  thailandReceivedAt    DateTime? @map("thailand_received_at")

  // 取消
  cancelReason String?   @map("cancel_reason") @db.Text
  cancelledAt  DateTime? @map("cancelled_at")

  // 付款那一刻的价格快照（2026-09-16，确认单 4.14）：付款时写、撤销付款时清空；之后谁改价都不变
  paidPriceNormal          Decimal? @map("paid_price_normal") @db.Decimal(10, 2)
  paidPriceInspection      Decimal? @map("paid_price_inspection") @db.Decimal(10, 2)
  paidPriceSensitive       Decimal? @map("paid_price_sensitive") @db.Decimal(10, 2)
  /// 付款时客户归哪个代理；湘泰自己的客户为空（下面代理价、返现也为空）
  paidAgentId              String?  @map("paid_agent_id")
  paidAgentPriceNormal     Decimal? @map("paid_agent_price_normal") @db.Decimal(10, 2)
  paidAgentPriceInspection Decimal? @map("paid_agent_price_inspection") @db.Decimal(10, 2)
  paidAgentPriceSensitive  Decimal? @map("paid_agent_price_sensitive") @db.Decimal(10, 2)
  rebateAmount             Decimal? @map("rebate_amount") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  planCustomer WhrConsolidationPlanCustomer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items        WhrConsolidationPrealertItem[]
  statusLogs   WhrConsolidationStatusLog[]

  @@index([customerId])
  @@index([companyId, customerId])
  @@index([status])
  // ⚠️ 默认索引名 68 个字符，超过 PostgreSQL 63 字符上限被库截掉了末尾 "idx"（迁移 20260916 实测）。
  //    这里写明库里的真实名字，免得以后比对结构时报「索引名不一致」。
  @@index([paidAgentId, thailandReceivedAt], map: "whr_consolidation_prealerts_paid_agent_id_thailand_received_at_")
  @@map("whr_consolidation_prealerts")
}

model WhrConsolidationPrealertItem {
  id                   String   @id @default(cuid())
  prealertId           String   @map("prealert_id")
  companyId            String   @map("company_id")
  productName          String   @map("product_name")
  packageCount         Int      @map("package_count")
  quantityPerBox       Int      @default(1) @map("quantity_per_box")
  totalQuantity        Int      @default(0) @map("total_quantity") // packageCount * quantityPerBox
  lengthCm             Decimal? @map("length_cm") @db.Decimal(10, 2)
  widthCm              Decimal? @map("width_cm") @db.Decimal(10, 2)
  heightCm             Decimal? @map("height_cm") @db.Decimal(10, 2)
  unitWeightKg         Decimal? @map("unit_weight_kg") @db.Decimal(10, 2)
  totalWeightKg        Decimal? @map("total_weight_kg") @db.Decimal(10, 2) // unitWeightKg * totalQuantity
  volumeM3             Decimal? @map("volume_m3") @db.Decimal(10, 6) // lengthCm*widthCm*heightCm/1000000*packageCount
  material             String   @map("material")
  cargoValue           String   @map("cargo_value")
  cargoType            String   @default("normal") @map("cargo_type") // normal | inspection | sensitive
  productImageFileName String?  @map("product_image_file_name")
  productImageMime     String?  @map("product_image_mime")
  productImageBase64   String?  @map("product_image_base64") @db.Text
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")

  prealert WhrConsolidationPrealert @relation(fields: [prealertId], references: [id], onDelete: Cascade)

  @@index([prealertId, sortOrder])
  @@map("whr_consolidation_prealert_items")
}

model WhrConsolidationStatusLog {
  id           String   @id @default(cuid())
  prealertId   String   @map("prealert_id")
  companyId    String   @map("company_id")
  operatorId   String   @map("operator_id")
  operatorRole String   @map("operator_role")
  operatorName String   @map("operator_name")
  fromStatus   String   @map("from_status")
  toStatus     String   @map("to_status")
  remark       String?  @map("remark")
  createdAt    DateTime @default(now()) @map("created_at")

  prealert WhrConsolidationPrealert @relation(fields: [prealertId], references: [id], onDelete: Cascade)

  @@index([prealertId, createdAt(sort: Desc)])
  @@map("whr_consolidation_status_logs")
}

// ============================================================================
// 代理账号（2026-09-16，迁移 20260916_agent_accounts）
// 需求编号见 docs/交接文档-附件-代理账号确认单/final.md（该目录不进 git）
// ============================================================================

/// 代理。停用代理 = 停它的登录账号（users.status），不在这张表上。
model Agent {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  name            String
  /// 走现有图片落盘，存 /images/...（登录前就要显示）
  logoPath        String?  @map("logo_path")
  /// 前缀登录：网址/<slug>
  slug            String?  @unique
  customDomain    String?  @unique @map("custom_domain")
  /// 湘泰给代理的三档价 元/方
  priceNormal     Decimal  @map("price_normal") @db.Decimal(10, 2)
  priceInspection Decimal  @map("price_inspection") @db.Decimal(10, 2)
  priceSensitive  Decimal  @map("price_sensitive") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  users            User[]                 @relation("AgentUsers")
  rebateStatements AgentRebateStatement[]

  @@index([companyId])
  @@map("agents")
}

/// 客户长期价（仓库版集货，所有客户；4.4 / 4.19）。加进柜子时自动带出。
model ClientWhrPrice {
  clientId        String   @id @map("client_id")
  companyId       String   @map("company_id")
  priceNormal     Decimal  @map("price_normal") @db.Decimal(10, 2)
  priceInspection Decimal  @map("price_inspection") @db.Decimal(10, 2)
  priceSensitive  Decimal  @map("price_sensitive") @db.Decimal(10, 2)
  /// 操作人只给超管看（沿用 canSeeOperatorIdentity）；上线回填的行为空
  updatedBy       String?  @map("updated_by")
  updatedByRole   String?  @map("updated_by_role")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  client User @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("client_whr_prices")
}

/// 每月返现单（4.12 / 4.13）。一个代理一个月一张，出了就不改；「已返」只改状态和时间。
model AgentRebateStatement {
  id            String    @id @default(cuid())
  companyId     String    @map("company_id")
  agentId       String    @map("agent_id")
  /// 'YYYY-MM'
  month         String    @db.VarChar(7)
  lineCount     Int       @map("line_count")
  totalVolumeM3 Decimal   @map("total_volume_m3") @db.Decimal(12, 3)
  totalRebate   Decimal   @map("total_rebate") @db.Decimal(12, 2)
  /// unpaid | paid
  status        String    @default("unpaid")
  generatedAt   DateTime  @default(now()) @map("generated_at")
  paidAt        DateTime? @map("paid_at")
  paidBy        String?   @map("paid_by")

  agent Agent             @relation(fields: [agentId], references: [id], onDelete: Restrict)
  lines AgentRebateLine[]

  @@unique([agentId, month])
  @@index([companyId])
  @@map("agent_rebate_statements")
}

/// 返现单明细（出单时冻结，4.20）。prealertId 唯一 = 一票只算一次。**不存柜号**（3.11 暂缓）
model AgentRebateLine {
  id                    String    @id @default(cuid())
  statementId           String    @map("statement_id")
  companyId             String    @map("company_id")
  prealertId            String    @unique @map("prealert_id")
  trackingNo            String    @map("tracking_no")
  planNo                String    @map("plan_no")
  clientId              String    @map("client_id")
  mark                  String
  productNames          String    @map("product_names") @db.Text
  volumeNormalM3        Decimal   @map("volume_normal_m3") @db.Decimal(12, 3)
  volumeInspectionM3    Decimal   @map("volume_inspection_m3") @db.Decimal(12, 3)
  volumeSensitiveM3     Decimal   @map("volume_sensitive_m3") @db.Decimal(12, 3)
  clientPriceNormal     Decimal   @map("client_price_normal") @db.Decimal(10, 2)
  clientPriceInspection Decimal   @map("client_price_inspection") @db.Decimal(10, 2)
  clientPriceSensitive  Decimal   @map("client_price_sensitive") @db.Decimal(10, 2)
  agentPriceNormal      Decimal   @map("agent_price_normal") @db.Decimal(10, 2)
  agentPriceInspection  Decimal   @map("agent_price_inspection") @db.Decimal(10, 2)
  agentPriceSensitive   Decimal   @map("agent_price_sensitive") @db.Decimal(10, 2)
  rebateAmount          Decimal   @map("rebate_amount") @db.Decimal(12, 2)
  /// 6 个时间：建单 / 仓库签收 / 付款 / 装柜 / 发运 / 泰国签收
  prealertCreatedAt     DateTime  @map("prealert_created_at")
  signedAt              DateTime? @map("signed_at")
  paidAt                DateTime? @map("paid_at")
  loadedAt              DateTime? @map("loaded_at")
  shippedAt             DateTime? @map("shipped_at")
  thailandReceivedAt    DateTime  @map("thailand_received_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  statement AgentRebateStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)

  @@index([statementId])
  @@map("agent_rebate_lines")
}
