// 湘泰国际物流系统 — Prisma Schema
// 设计原则：
//   1. 保留现有 18 张表的字段（snake_case 列名映射到 camelCase）
//   2. 新增 10 张表：Container / ShipmentContainerItem / WarehouseLocation /
//      Delivery / PricingRule / Invoice / InvoiceLine / Payment /
//      CustomerCredit / CreditHistory / AuditLog（共 11 张）
//   3. 保留 batch_no（批次）概念，与新增的 Container 并存
//   4. 所有金额用 Decimal；所有时间戳用 DateTime（PostgreSQL timestamptz）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 现有实体（从 SQLite ensureSchema 迁移）
// ============================================================================

model User {
  id           String   @id
  companyId    String   @map("company_id")
  role         String // admin | staff | client | agent
  name         String
  phone        String
  status       String // active | inactive
  warehouseIds String   @default("[]") @map("warehouse_ids") // JSON 字符串保留兼容性
  passwordHash String?  @map("password_hash")
  companyName  String?  @map("company_name")
  email        String?
  createdAt    DateTime @default(now()) @map("created_at")
  /// 2026-09-16 代理账号：role=agent 的行 = 这个代理的登录号；role=client 的行 = 归这个代理的客户；湘泰自己的为空
  agentId      String?  @map("agent_id")

  agent    Agent?          @relation("AgentUsers", fields: [agentId], references: [id], onDelete: Restrict)
  whrPrice ClientWhrPrice?

  // 关联
  ordersAsClient               Order[]                        @relation("ClientOrders")
  addresses                    ClientAddress[]
  documents                    ClientDocument[]
  walletAccounts               ClientWalletAccount[]
  walletRecharges              WalletRecharge[]               @relation("WalletRechargeClient")
  consolidationLedger          ConsolidationBalanceLedger[]
  reviewedRecharges            WalletRecharge[]               @relation("WalletRechargeReviewer")
  aiAuditLogs                  AiAuditLog[]
  inboundPhotos                StaffInboundPhoto[]            @relation("OperatorInboundPhotos")
  productImages                OrderProductImage[]
  credit                       CustomerCredit?
  invoices                     Invoice[]
  auditLogs                    AuditLog[]                     @relation("ActorAuditLogs")
  fclInquiries                 FclInquiry[]
  consolidationTasks           ConsolidationTask[]
  WhrConsolidationPlanCustomer WhrConsolidationPlanCustomer[]

  @@index([companyId])
  @@index([role])
  @@index([agentId])
  @@map("users")
}

model Order {
  id                     String    @id
  companyId              String    @map("company_id")
  clientId               String    @map("client_id")
  warehouseId            String    @map("warehouse_id")
  batchNo                String?   @map("batch_no")
  orderNo                String?   @map("order_no")
  approvalStatus         String    @default("approved") @map("approval_status")
  itemName               String    @map("item_name")
  productQuantity        Int       @map("product_quantity")
  packageCount           Int       @map("package_count")
  packageUnit            String    @map("package_unit")
  weightKg               Decimal?  @map("weight_kg") @db.Decimal(10, 2)
  volumeM3               Decimal?  @map("volume_m3") @db.Decimal(10, 3)
  receivableAmountCny    Decimal?  @map("receivable_amount_cny") @db.Decimal(12, 2)
  receivableCurrency     String    @default("CNY") @map("receivable_currency")
  paymentStatus          String    @default("unpaid") @map("payment_status")
  paidAt                 DateTime? @map("paid_at")
  paidBy                 String?   @map("paid_by")
  paymentProofFileName   String?   @map("payment_proof_file_name")
  paymentProofMime       String?   @map("payment_proof_mime")
  paymentProofBase64     String?   @map("payment_proof_base64") @db.Text
  paymentProofUploadedAt DateTime? @map("payment_proof_uploaded_at")

  // 付款凭证（多张，JSON 数组）
  paymentProofs      Json     @default("[]") @map("payment_proofs") @db.JsonB
  shipDate           String?  @map("ship_date")
  domesticTrackingNo String?  @map("domestic_tracking_no")
  transportMode      String   @map("transport_mode")
  receiverNameTh     String   @map("receiver_name_th")
  receiverPhoneTh    String   @map("receiver_phone_th")
  receiverAddressTh  String   @map("receiver_address_th")
  statusGroup        String   @default("unfinished") @map("status_group")
  // ⭐ 新增字段：货物类型（普货/商检/敏感），用于差异化计费
  cargoType          String   @default("normal") @map("cargo_type")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // 关联
  client            User                   @relation("ClientOrders", fields: [clientId], references: [id])
  shipments         Shipment[]
  productImages     OrderProductImage[]
  products          OrderProduct[]
  customsCases      AdminCustomsCase[]
  settlementEntries AdminSettlementEntry[]
  invoiceLines      InvoiceLine[]

  @@index([companyId, clientId])
  @@index([companyId, statusGroup])
  @@index([batchNo])
  @@map("orders")
}

model Shipment {
  id                 String   @id
  companyId          String   @map("company_id")
  orderId            String   @map("order_id")
  trackingNo         String   @unique @map("tracking_no")
  parentTrackingNo   String?  @map("parent_tracking_no")
  batchNo            String?  @map("batch_no")
  containerNo        String?  @map("container_no") // 保留兼容性，新代码用 ContainerItem
  currentStatus      String   @map("current_status")
  currentLocation    String?  @map("current_location")
  weightKg           Decimal? @map("weight_kg") @db.Decimal(10, 2)
  volumeM3           Decimal? @map("volume_m3") @db.Decimal(10, 3)
  itemName           String?  @map("item_name")
  packageCount       Int?     @map("package_count")
  packageUnit        String?  @map("package_unit")
  transportMode      String?  @map("transport_mode")
  domesticTrackingNo String?  @map("domestic_tracking_no")
  warehouseId        String   @map("warehouse_id")
  remark             String?  @map("remark")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // 关联
  order             Order                   @relation(fields: [orderId], references: [id])
  statusLogs        StatusLog[]
  containerItems    ShipmentContainerItem[]
  warehouseLocation WarehouseLocation?
  delivery          Delivery?
  inboundPhotos     StaffInboundPhoto[]
  customsCases      AdminCustomsCase[]
  lastmileOrders    AdminLastmileOrder[]

  @@index([companyId, currentStatus])
  @@index([companyId, updatedAt])
  @@index([orderId])
  @@index([batchNo])
  @@index([parentTrackingNo])
  @@map("shipments")
}

/// 推柜子状态的账本（2026-09-17 老板定「推进账本」做法）：每推一次一笔，整柜撤销只认这里，不再靠轨迹记录和日期猜
model ContainerPushBatch {
  id                  String    @id
  companyId           String    @map("company_id")
  containerId         String    @map("container_id")
  seq                 Int
  fromContainerStatus String    @map("from_container_status")
  toContainerStatus   String    @map("to_container_status")
  changedAt           DateTime  @map("changed_at")
  prevStatusDates     String?   @map("prev_status_dates")
  prevDepartureDate   DateTime? @map("prev_departure_date")
  prevAta             DateTime? @map("prev_ata")
  operatorId          String    @map("operator_id")
  createdAt           DateTime  @default(now()) @map("created_at")

  container Container          @relation(fields: [containerId], references: [id], onDelete: Cascade)
  entries   ContainerPushEntry[]

  @@unique([containerId, seq])
  @@index([companyId])
  @@map("container_push_batches")
}

/// 账本里这一笔涉及的每票货：推之前/推之后的状态，以及这一步写给客户看的那条轨迹
model ContainerPushEntry {
  id          String   @id
  companyId   String   @map("company_id")
  batchId     String   @map("batch_id")
  shipmentId  String   @map("shipment_id")
  fromStatus  String   @map("from_status")
  toStatus    String   @map("to_status")
  statusLogId String?  @map("status_log_id")
  kind        String
  createdAt   DateTime @default(now()) @map("created_at")

  batch ContainerPushBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([shipmentId])
  @@map("container_push_entries")
}

model StatusLog {
  id           String   @id
  companyId    String   @map("company_id")
  shipmentId   String   @map("shipment_id")
  operatorId   String   @map("operator_id")
  operatorRole String   @map("operator_role")
  operatorName String   @default("") @map("operator_name")
  fromStatus   String   @map("from_status")
  toStatus     String   @map("to_status")
  remark       String?
  // 2026-08-06：轨迹上给客户看的「下一站【泰国边境】」。
  // 推进柜子状态时按状态取默认值，员工也可以手填覆盖；空着就不显示这一行。
  nextStop     String?  @map("next_stop")
  changedAt    DateTime @default(now()) @map("changed_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, changedAt])
  @@map("status_logs")
}

// ============================================================================
// 现有 AI 相关表
// ============================================================================

model AiSessionMemory {
  key         String   @id
  companyId   String   @map("company_id")
  userId      String   @map("user_id")
  sessionId   String   @map("session_id")
  intent      String?
  itemName    String?  @map("item_name")
  statusScope String?  @map("status_scope")
  timeHint    String?  @map("time_hint")
  metric      String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("ai_session_memory")
}

model AiStatusLabel {
  status    String   @id
  labelZh   String   @map("label_zh")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_status_labels")
}

model AiKnowledgeItem {
  id        String   @id
  companyId String   @map("company_id")
  title     String
  content   String   @db.Text
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt(sort: Desc)])
  @@map("ai_knowledge_items")
}

model AiAuditLog {
  id                    String   @id
  userId                String   @map("user_id")
  companyId             String   @map("company_id")
  sessionId             String?  @map("session_id")
  question              String   @db.Text
  answerSummary         String   @map("answer_summary") @db.Text
  referencedOrderIds    String?  @map("referenced_order_ids")
  referencedShipmentIds String?  @map("referenced_shipment_ids")
  queriedAt             DateTime @default(now()) @map("queried_at")

  user User @relation(fields: [userId], references: [id])

  @@index([companyId, queriedAt(sort: Desc)])
  @@map("ai_audit_logs")
}

model AiKnowledgeGap {
  id                  String    @id
  companyId           String    @map("company_id")
  userId              String    @map("user_id")
  sessionId           String?   @map("session_id")
  question            String    @db.Text
  answerSummary       String    @map("answer_summary") @db.Text
  knowledgeCountAtAsk Int       @default(0) @map("knowledge_count_at_ask")
  status              String    @default("open")
  createdAt           DateTime  @default(now()) @map("created_at")
  resolvedAt          DateTime? @map("resolved_at")
  resolvedBy          String?   @map("resolved_by")

  @@index([companyId, status, createdAt(sort: Desc)])
  @@map("ai_knowledge_gaps")
}

// ============================================================================
// 客户相关
// ============================================================================

model ClientAddress {
  id            String   @id
  companyId     String   @map("company_id")
  clientId      String   @map("client_id")
  contactName   String   @map("contact_name")
  contactPhone  String   @map("contact_phone")
  addressDetail String   @map("address_detail")
  lat           Decimal? @db.Decimal(10, 6)
  lng           Decimal? @db.Decimal(10, 6)
  label         String?
  isDefault     Int      @default(0) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  client User @relation(fields: [clientId], references: [id])

  @@index([clientId, updatedAt(sort: Desc)])
  @@map("client_addresses")
}

model ClientDocument {
  id            String   @id
  companyId     String   @map("company_id")
  clientId      String   @map("client_id")
  docType       String   @map("doc_type")
  fileName      String   @map("file_name")
  mime          String
  contentBase64 String   @map("content_base64") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  client User @relation(fields: [clientId], references: [id])

  @@index([clientId, createdAt(sort: Desc)])
  @@map("client_documents")
}

model ClientWalletAccount {
  clientId  String
  companyId String   @map("company_id")
  currency  String
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  client User @relation(fields: [clientId], references: [id])

  @@id([clientId, currency])
  @@map("client_wallet_accounts")
}

model ClientExchangeRate {
  baseCurrency  String   @map("base_currency")
  quoteCurrency String   @map("quote_currency")
  rate          Decimal  @db.Decimal(14, 6)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@id([baseCurrency, quoteCurrency])
  @@map("client_exchange_rates")
}

model WalletRecharge {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  clientId      String   @map("client_id")
  currency      String
  amount        Decimal  @db.Decimal(14, 2)
  paymentMethod String   @map("payment_method")
  proofImage    String   @map("proof_image") @db.Text
  remark        String?
  status        String   @default("PENDING")
  reviewRemark  String?  @map("review_remark")
  reviewedBy    String?  @map("reviewed_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  client   User  @relation("WalletRechargeClient", fields: [clientId], references: [id])
  reviewer User? @relation("WalletRechargeReviewer", fields: [reviewedBy], references: [id])

  @@index([companyId, status])
  @@index([clientId])
  @@map("wallet_recharges")
}

/// 集货余额流水（2026-08-07）
/// 「余额」现在只服务两个集货板块（仓库版 / 普通版），普通运单不再能用余额付。
/// 每一笔充值、付款、退款都在这里记一行，客户能看到自己的完整账目。
/// 只有人民币，没有币种列 —— 泰铢余额已废弃。
model ConsolidationBalanceLedger {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  clientId     String   @map("client_id")
  /// recharge=充值到账 | pay=集货付款 | refund=管理员撤销退款
  type         String
  /// 正数进账、负数出账，单位元
  amount       Decimal  @db.Decimal(14, 2)
  /// 这一笔之后的余额，客户对账时不用自己累加
  balanceAfter Decimal  @map("balance_after") @db.Decimal(14, 2)
  /// 关联单据：whr=仓库版预报单 | normal=普通版任务 | recharge=充值单
  refType      String?  @map("ref_type")
  refId        String?  @map("ref_id")
  /// 给客户看的单号（预报单号 / 计划号等）
  refNo        String?  @map("ref_no")
  remark       String?
  /// 谁操作的：客户自己付款就是客户，审核/撤销就是管理员
  operatorId   String?  @map("operator_id")
  operatorName String?  @map("operator_name")
  createdAt    DateTime @default(now()) @map("created_at")

  client User @relation(fields: [clientId], references: [id])

  @@index([companyId, clientId, createdAt])
  @@index([refType, refId])
  @@map("consolidation_balance_ledger")
}

// ============================================================================
// 员工相关
// ============================================================================

model StaffInboundPhoto {
  id            String   @id
  companyId     String   @map("company_id")
  shipmentId    String   @map("shipment_id")
  operatorId    String   @map("operator_id")
  fileName      String   @map("file_name")
  mime          String
  contentBase64 String   @map("content_base64") @db.Text
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  operator User     @relation("OperatorInboundPhotos", fields: [operatorId], references: [id])

  @@index([shipmentId, createdAt(sort: Desc)])
  @@map("staff_inbound_photos")
}

model OrderProductImage {
  id            String   @id
  companyId     String   @map("company_id")
  orderId       String   @map("order_id")
  fileName      String   @map("file_name")
  mime          String
  contentBase64 String   @map("content_base64") @db.Text
  filePath      String?  @map("file_path")
  uploadedBy    String   @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploadedBy], references: [id])

  @@index([companyId, orderId, createdAt])
  @@map("order_product_images")
}

model OrderProduct {
  id                 String   @id @default(cuid())
  companyId          String   @map("company_id")
  orderId            String   @map("order_id")
  itemName           String   @map("item_name")
  packageCount       Int      @default(1) @map("package_count")
  lengthCm           Float?   @map("length_cm")
  widthCm            Float?   @map("width_cm")
  heightCm           Float?   @map("height_cm")
  productQuantity    Int?     @map("product_quantity")
  cargoType          String   @default("normal") @map("cargo_type")
  domesticTrackingNo String   @default("货拉拉") @map("domestic_tracking_no")
  weightKg           Float?   @map("weight_kg")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId, orderId, sortOrder])
  @@map("order_products")
}

// ============================================================================
// 管理员运营模块
// ============================================================================

model AdminLmpRate {
  id            String   @id
  companyId     String   @map("company_id")
  routeCode     String   @map("route_code")
  supplierName  String   @map("supplier_name")
  transportMode String   @map("transport_mode")
  seasonTag     String   @map("season_tag")
  supplierCost  Decimal  @map("supplier_cost") @db.Decimal(12, 2)
  quotePrice    Decimal  @map("quote_price") @db.Decimal(12, 2)
  currency      String   @default("CNY")
  effectiveFrom String   @map("effective_from")
  effectiveTo   String?  @map("effective_to")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([routeCode, updatedAt(sort: Desc)])
  @@map("admin_lmp_rates")
}

model AdminCustomsCase {
  id         String   @id
  companyId  String   @map("company_id")
  shipmentId String?  @map("shipment_id")
  orderId    String?  @map("order_id")
  status     String
  remark     String?
  updatedAt  DateTime @updatedAt @map("updated_at")

  shipment Shipment? @relation(fields: [shipmentId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])

  @@index([status, updatedAt(sort: Desc)])
  // 同上：列表页按公司筛 + 按时间倒序（2026-08-27 补）
  @@index([companyId, updatedAt(sort: Desc)])
  @@map("admin_customs_cases")
}

model AdminLastmileOrder {
  id                 String   @id
  companyId          String   @map("company_id")
  // 2026-08-06：这里原来是 @unique —— 但派送单号代表「一车」，一车拉多个运单时
  // 每个运单存一行、共用同一个号，唯一约束直接把「一车多单」堵死了：
  // 选 2 个及以上必定在第 2 行报 Unique constraint failed，而第 1 行已经写进去、
  // 运单状态也已改成「派送中」，于是留下没有派送单的孤儿运单（生产实测 3 张）。
  // 唯一性改由「同一个号 + 同一个运单不能重复」来保证，见下面的 @@unique。
  deliveryNo         String   @map("delivery_no")
  shipmentId         String   @map("shipment_id")
  carrierName        String   @map("carrier_name")
  externalTrackingNo String   @map("external_tracking_no")
  driverName         String?  @map("driver_name")
  licensePlate       String?  @map("license_plate")
  phoneNumber        String?  @map("phone_number")
  signImageBase64    String?  @map("sign_product_image_base64") @db.Text
  deliveryDate       String?  @map("delivery_date")
  status             String
  updatedAt          DateTime @updatedAt @map("updated_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // 同一张派送单里同一个运单只能出现一次（防重复点击把同一票货装两遍）
  @@unique([deliveryNo, shipmentId])
  @@index([deliveryNo, updatedAt(sort: Desc)])
  @@index([shipmentId, updatedAt(sort: Desc)])
  // 列表页就是「按公司筛 + 按时间倒序」，原来没有覆盖这个组合的索引（2026-08-27 补）
  @@index([companyId, updatedAt(sort: Desc)])
  @@map("admin_lastmile_orders")
}

model AdminSettlementEntry {
  id               String   @id
  companyId        String   @map("company_id")
  orderId          String   @map("order_id")
  clientReceivable Decimal  @map("client_receivable") @db.Decimal(12, 2)
  supplierPayable  Decimal  @map("supplier_payable") @db.Decimal(12, 2)
  taxFee           Decimal  @map("tax_fee") @db.Decimal(12, 2)
  currency         String   @default("CNY")
  updatedAt        DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, updatedAt(sort: Desc)])
  @@map("admin_settlement_entries")
}

// ============================================================================
// ⭐ 新增：集装箱 & 拆柜
// ============================================================================

model Container {
  id               String    @id @default(cuid())
  companyId        String    @map("company_id")
  containerNo      String    @unique @map("container_no") // 柜号
  containerType    String    @map("container_type") // 20GP | 40HQ
  // sea = 海运 | land = 陆运。null = 2026-08-05 之前建的老柜子，判不出来，由员工自己补。
  // 柜子和里面装的运单各有各的运输方式，允许不一致（线上真实存在 5 个海陆混装的柜），
  // 装柜时只提醒不拦截，别改成硬校验。
  transportMode    String?   @map("transport_mode")
  // 2026-08-06：每个状态实际发生的日期，形如 {"SEALED":"2026-07-20T00:00:00.000Z",...}。
  // 柜子原来只存了开船(departure_date)和到港(ata)两个日期，陆运那几步压根没地方存 ——
  // 而「货到了才建柜」时要给运单补记轨迹，没有真实日期就只能瞎摊，补出来的时间是假的。
  statusDates      String?   @map("status_dates")
  warehouseId      String?   @map("warehouse_id")
  carrierName      String?   @map("carrier_name")
  sealedAt         DateTime? @map("sealed_at")
  loadingDate      DateTime? @map("loading_date") // 装柜日期
  departureDate    DateTime? @map("departure_date") // 开船日期
  eta              DateTime? // 预计到港
  ata              DateTime? // 实际到港
  customsClearedAt DateTime? @map("customs_cleared_at") // 清关完成
  currentStatus    String    @default("LOADING") @map("current_status")
  // 状态枚举：LOADING / IN_TRANSIT / ARRIVED / CUSTOMS / DELIVERING / SIGNED
  /// 整柜（2026-09-23 老板拍板）：true = 客户自己包的一整柜，由「整柜管理」建；
  /// false = 现在的拼柜，行为完全不变。线上已有的柜子迁移后全是 false。
  isFcl            Boolean   @default(false) @map("is_fcl")
  remark           String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  items ShipmentContainerItem[]
  pushBatches ContainerPushBatch[]

  @@index([companyId, currentStatus])
  @@index([companyId, isFcl])
  @@map("containers")
}

model ShipmentContainerItem {
