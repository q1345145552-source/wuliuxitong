model ConsolidationTask {
  id             String  @id @default(cuid())
  taskNo         String  @unique @map("task_no") // JH + 7位数字
  companyId      String  @map("company_id")
  clientId       String  @map("client_id")
  destinationTh  String  @map("destination_th") @db.Text
  status         String  @default("collecting") // collecting | confirmed | loading | shipped | completed | cancelled
  maxVolumeM3    Decimal @default(68) @map("max_volume_m3") @db.Decimal(10, 2)
  totalVolumeM3  Decimal @default(0) @map("total_volume_m3") @db.Decimal(10, 3)
  totalPackages  Int     @default(0) @map("total_packages")
  totalPrealerts Int     @default(0) @map("total_prealerts")

  bookingFee Decimal? @map("booking_fee") @db.Decimal(12, 2)
  customsFee Decimal? @map("customs_fee") @db.Decimal(12, 2)
  loadingFee Decimal? @map("loading_fee") @db.Decimal(12, 2)
  totalFee   Decimal? @map("total_fee") @db.Decimal(12, 2) // bookingFee + customsFee + loadingFee
  currency   String   @default("CNY") @map("currency")

  paymentStatus          String    @default("unpaid") @map("payment_status") // unpaid | pending_review | paid
  paidAt                 DateTime? @map("paid_at")
  paymentProofFileName   String?   @map("payment_proof_file_name")
  paymentProofMime       String?   @map("payment_proof_mime")
  paymentProofBase64     String?   @map("payment_proof_base64") @db.Text
  paymentProofUploadedAt DateTime? @map("payment_proof_uploaded_at")
  paymentReviewedAt      DateTime? @map("payment_reviewed_at")
  paymentReviewedBy      String?   @map("payment_reviewed_by")
  paymentRejectReason    String?   @map("payment_reject_reason") @db.Text

  containerNo String? @map("container_no")
  loadingDate String? @map("loading_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client     User                     @relation(fields: [clientId], references: [id])
  prealerts  ConsolidationPrealert[]
  statusLogs ConsolidationStatusLog[]

  @@index([companyId, clientId])
  @@index([companyId, status])
  @@map("consolidation_tasks")
}

model ConsolidationPrealert {
  id                    String    @id @default(cuid())
  taskId                String    @map("task_id")
  companyId             String    @map("company_id")
  clientId              String    @map("client_id")
  trackingNo            String    @unique @map("tracking_no") // JH-YW + 7位数字
  expressNo             String?   @map("express_no")
  mark                  String    @map("mark")
  status                String    @default("pending") @map("status") // pending | received
  signedAt              DateTime? @map("signed_at")
  receivedProofFileName String?   @map("received_proof_file_name")
  receivedProofMime     String?   @map("received_proof_mime")
  receivedProofBase64   String?   @map("received_proof_base64") @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  task     ConsolidationTask              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  products ConsolidationPrealertProduct[]

  @@index([taskId])
  @@index([companyId, taskId])
  @@map("consolidation_prealerts")
}

model ConsolidationPrealertProduct {
  id             String   @id @default(cuid())
  prealertId     String   @map("prealert_id")
  productName    String   @map("product_name")
  packageCount   Int      @map("package_count")
  quantityPerBox Int      @default(1) @map("quantity_per_box")
  totalQuantity  Int      @default(0) @map("total_quantity") // packageCount * quantityPerBox
  unitWeight     Decimal? @map("unit_weight") @db.Decimal(10, 2)
  totalWeight    Decimal? @map("total_weight") @db.Decimal(10, 2) // unitWeight * totalQuantity

  length Decimal? @map("length_cm") @db.Decimal(10, 2)
  width  Decimal? @map("width_cm") @db.Decimal(10, 2)
  height Decimal? @map("height_cm") @db.Decimal(10, 2)
  volume Decimal? @map("volume_m3") @db.Decimal(10, 6) // length*width*height/1000000*packageCount

  material   String @map("material")
  cargoValue String @map("cargo_value")
  cargoType  String @default("normal") @map("cargo_type") // normal | inspection | sensitive（普通版只记录，不参与计价）

  productImageFileName String? @map("product_image_file_name")
  productImageMime     String? @map("product_image_mime")
  productImageBase64   String? @map("product_image_base64") @db.Text

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  prealert ConsolidationPrealert @relation(fields: [prealertId], references: [id], onDelete: Cascade)

  @@index([prealertId, sortOrder])
  @@map("consolidation_prealert_products")
}

model ConsolidationStatusLog {
  id           String   @id @default(cuid())
  taskId       String   @map("task_id")
  companyId    String   @map("company_id")
  operatorId   String   @map("operator_id")
  operatorRole String   @map("operator_role")
  operatorName String   @map("operator_name")
  fromStatus   String   @map("from_status")
  toStatus     String   @map("to_status")
  remark       String?  @map("remark")
  createdAt    DateTime @default(now()) @map("created_at")

  task ConsolidationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt(sort: Desc)])
  @@map("consolidation_status_logs")
}

