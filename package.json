{
  "name": "xiangtai-logistics",
  "private": true,
  "description": "湘泰物流：根目录安装 tsx 后可在仓库根运行后端；前端在 apps/web",
  "scripts": {
    "postinstall": "npm install --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "start": "npm run start --prefix apps/web",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:web:public": "npm run dev:public --prefix apps/web",
    "dev:web:lan": "node scripts/dev-web-lan.mjs",
    "build:web": "npm run build --prefix apps/web",
    "start:web": "npm run start --prefix apps/web",
    "db:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=apps/api/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=apps/api/prisma/schema.prisma",
    "db:seed": "tsx apps/api/prisma/seed.ts",
    "db:reset": "prisma migrate reset --schema=apps/api/prisma/schema.prisma",
    "test:login-throttle": "tsx scripts/test-login-throttle.ts",
    "test:session-stability": "tsx scripts/test-session-stability.ts",
    "test:session-api": "tsx scripts/test-session-api.ts",
    "test:unload": "tsx scripts/test-unload.ts",
    "test:frontend-guards": "tsx scripts/test-frontend-guards.ts",
    "test:money-guards": "tsx scripts/test-money-guards.ts",
    "test:product-rows": "tsx scripts/test-product-rows.ts",
    "test:address-update": "tsx scripts/test-client-address-update.ts",
    "test:batch-import": "tsx scripts/test-staff-batch-import.ts",
    "test:lock-order": "tsx scripts/test-lock-order.ts",
    "test:api-response": "tsx scripts/test-api-response-shape.ts",
    "test:fcl-inquiries": "tsx scripts/test-fcl-inquiries.ts",
    "test:status-group": "tsx scripts/test-client-status-group.ts",
    "test:attention-filter": "tsx scripts/test-attention-filter.ts",
    "test:consolidation-delete": "tsx scripts/test-consolidation-delete-guard.ts",
    "test:lastmile-export": "tsx scripts/test-lastmile-export.ts",
    "test:lastmile-dispatch-rules": "tsx scripts/test-lastmile-dispatch-rules.ts",
    "test:lastmile-product-names": "tsx scripts/test-lastmile-product-names.ts",
    "test:ai-numbers": "TZ=UTC tsx scripts/test-ai-answer-numbers.ts && TZ=Asia/Shanghai tsx scripts/test-ai-answer-numbers.ts",
    "test:ai-limits": "tsx scripts/test-ai-chat-limits.ts",
    "test:ai-timeout": "tsx scripts/test-deepseek-timeout.ts",
    "typecheck:scripts": "tsc --noEmit --project tsconfig.scripts.json",
    "test:shipment-list-display": "tsx scripts/test-shipment-list-display.ts",
    "test:admin-shipment-detail": "tsx scripts/test-admin-shipment-detail.ts",
    "test:cargo-regressions": "tsx scripts/test-cargo-regressions.ts",
    "test:dispatch-wrap": "tsx scripts/test-dispatch-wrap.ts",
    "test:shipment-track-actions": "tsx scripts/test-shipment-track-actions.ts",
    "test:hide-operator-identity": "tsx scripts/test-hide-operator-identity.ts",
    "test:agent-foundation": "tsx scripts/test-agent-foundation.ts"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "ssh2": "^1.17.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
