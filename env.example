# 复制为 .env 后填写（不要提交 .env 到 Git）

# ============ 必填 ============

# JWT 鉴权密钥，至少 32 位随机字符串
# 生成示例：openssl rand -base64 48
AUTH_SECRET=请替换为至少32位随机密钥

# CORS 允许的来源域名（生产环境必须设置，开发环境可使用 *）
# CORS_ORIGIN=https://your-frontend-domain.com

# Redis 密码（用于docker-compose中Redis认证）
# REDIS_PASSWORD=xiangtai_redis_dev

# ============ 快递100物流查询（可选）============

KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
# KUAIDI100_QUERY_URL=https://poll.kuaidi100.com/poll/query.do
# KUAIDI100_WEB_QUERY_URL=https://www.kuaidi100.com/query

# ============ 汇率服务（可选）============

# EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/CNY

# ============ 飞书通知（可选）============

# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# ============ 数据库（PostgreSQL）============

# 开发推荐用 docker compose 起的 Postgres
# ⚠️ 宿主机端口用 5433（避开本机可能已有的 Postgres 5432）
# 本机直连 Docker 容器：postgresql://xiangtai:xiangtai_dev@localhost:5433/xiangtai?schema=public
# 容器内 API 访问（docker compose 内部网络，容器内仍是 5432）：postgresql://xiangtai:xiangtai_dev@postgres:5432/xiangtai?schema=public
# 生产环境（如 Render Postgres / AWS RDS）：填运营方提供的连接串
DATABASE_URL=postgresql://xiangtai:xiangtai_dev@localhost:5433/xiangtai?schema=public

# Postgres 容器初始化参数（仅 docker compose 用，本机直连无需关心）
POSTGRES_USER=xiangtai
POSTGRES_PASSWORD=xiangtai_dev
POSTGRES_DB=xiangtai

# ============ 异步任务队列（Redis）============

# 本机直连 Docker：redis://:xiangtai_redis_dev@localhost:6379
# 容器内 API 访问：redis://:xiangtai_redis_dev@redis:6379
REDIS_URL=redis://:xiangtai_redis_dev@localhost:6379

# ============ 前端访问后端的地址 ============

# 浏览器访问后端的完整根地址（含协议与端口，无尾部斜杠）
# 本机 Docker：http://你的服务器公网IP:3001
# 已绑定域名与 HTTPS：https://api.你的域名.com
# 同一局域网他人访问本机开发服务：填本机局域网 IP，例如 http://192.168.1.100:3001（勿用 127.0.0.1）
# 或根目录执行 npm run dev:web:lan 自动写入本机 IP
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# ============ DeepSeek AI（可选；不填则相关接口不可用）============

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/chat/completions

# ============ AI 聊天的上限（可选，不填用代码里的默认值）============
# ⚠️ 部署文档写的是 `cp env.example .env`，所以要改线上参数请改**这个文件复制出来的 .env**。
# 根目录还有一个 .env.example 是本地开发用的，两边都列了同一组变量。
# 改完必须 `docker compose up -d`（重建容器）才会生效，docker-compose.yml 里已透传。
#
# /client/ai/chat 每条消息固定调两次 DeepSeek，是全系统唯一直接花钱的接口。
# 填了非正整数会被忽略、退回默认值，并在日志里留一条 WARN。
# ⚠️ 限流计数存在内存里，API 一重启就清零；上多进程要换成 Redis。
AI_CHAT_MAX_PER_MINUTE=10
AI_CHAT_MAX_PER_DAY=200
# 客户端「AI问答」输入框没有限字数，超长由后端按这个值挡（400 + 中文提示）
AI_CHAT_MAX_MESSAGE_CHARS=500
# 单次调用超时（毫秒）。一条消息串行调两次，前端单次请求 30 秒超时 ——
# 12+12 秒留 6 秒给数据库，改大之前先想想前端那 30 秒。
DEEPSEEK_TIMEOUT_MS=12000

# ============ 客服对话的浏览器系统通知（可选；不填就不出现「开启通知」）============
# 2026-10-02：客户 / 员工在聊天页点「开启通知」后，没开系统页面也能在电脑右下角 / 手机通知栏收到新消息提醒。
# 三项都要填才会开。公钥私钥是一对，在服务器上生成一次：
#   docker compose run --rm -T api npx web-push generate-vapid-keys
# ⚠️ 生成以后**别再换**：换了所有人已经开的通知全部失效，要重新点一次「开启通知」。
# ⚠️ 私钥只放在服务器的 .env 里，别提交到 Git、别发给别人。
# VAPID_SUBJECT 填 mailto:你的邮箱（各家推送服务出问题时联系用，必须 mailto: 或 https:// 开头）。
# 改完必须 `docker compose up -d`（重建容器）才会生效，docker-compose.yml 里已透传。
# 服务器要能连上各家推送服务（fcm.googleapis.com / web.push.apple.com / updates.push.services.mozilla.com）；
# 服务器在中国大陆的话谷歌那家连不上：Chrome / Edge 收不到，苹果、火狐不受影响。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ============ 对接拆派仓（2026-10-12；可选，不开就不影响任何现有功能）============
# 拆派仓到货扫码台来拉柜子清单（GET /integrations/chaipai/v2/container-manifest），
# 再把「已到泰国仓 / 泰国已装车 / 派送中 / 已签收」回传过来（POST /integrations/chaipai/v2/events），
# 派送中 / 已签收自动登记尾端派送单；员工在轨迹弹窗能看到拆派仓的「派送照片」。
# ⚠️ 服务器部署复制的是根目录的 `env.example`，这一组两边都要有，改了记得两边同步。
# CHAIPAI_ENABLED 只认 true，默认关。三把密钥由拆派仓那边生成：各自随机、至少 32 位、互不相同，
#   跟拆派仓 DOMESTIC_PULL_SECRET / DOMESTIC_V2_CALLBACK_SECRET / DOMESTIC_READ_SECRET 一一对应。
# ⚠️ 密钥只放在服务器的 .env 里，别提交到 Git、别发聊天。
# CHAIPAI_COMPANY_ID 填 xiangtai（跟拆派仓 DOMESTIC_COMPANY_ID 一字不差）；CHAIPAI_API_BASE 生产填 https://xtchaipai.top/api。
# 开的顺序：先开湘泰这边，再请拆派仓开回传；关的顺序反过来（拆派仓回传失败约 4 小时后就不再自动重发）。
# 改完必须 `docker compose up -d`（重建容器）才会生效，docker-compose.yml 里已透传。
CHAIPAI_ENABLED=
CHAIPAI_COMPANY_ID=
CHAIPAI_PULL_SECRET=
CHAIPAI_CALLBACK_SECRET=
CHAIPAI_READ_SECRET=
CHAIPAI_API_BASE=
