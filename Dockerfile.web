# 前端：Next.js 生产构建（构建时注入浏览器可访问的 API 根地址）
# Node 小版本跟 Dockerfile.api 一起钉死（2026-10-23 安全审查 S2），升级时本文件两处 FROM、Dockerfile.api 和 ci.yml 三处 node-version 一起改
FROM node:22.23.4-alpine AS builder

WORKDIR /app

COPY packages/shared-types ./packages/shared-types
COPY apps/web/package.json apps/web/package-lock.json ./apps/web/

WORKDIR /app/apps/web

RUN npm ci

COPY apps/web .

ARG NEXT_PUBLIC_API_BASE_URL
RUN test -n "$NEXT_PUBLIC_API_BASE_URL" || (echo "❌ NEXT_PUBLIC_API_BASE_URL is required" && exit 1)
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}

RUN npm run build

FROM node:22.23.4-alpine AS runner

WORKDIR /app/apps/web

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
# 转发目标显式写死成容器内的 api 服务，真实环境变量优先级高于 .env 文件，
# 万一有本机配置漏进镜像也压不过这里
ENV API_PROXY_TARGET=http://api:3001

COPY --chown=node:node --from=builder /app/apps/web/.next ./.next
COPY --chown=node:node --from=builder /app/apps/web/public ./public
COPY --chown=node:node --from=builder /app/apps/web/package.json ./
COPY --chown=node:node --from=builder /app/apps/web/package-lock.json ./
COPY --chown=node:node --from=builder /app/apps/web/next.config.ts ./
COPY --chown=node:node --from=builder /app/apps/web/tsconfig.json ./
COPY --chown=node:node --from=builder /app/apps/web/node_modules ./node_modules

EXPOSE 3000

USER node

CMD ["npm", "run", "start"]
