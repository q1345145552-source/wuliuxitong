# 湘泰物流网站 — 环境变量

# API 地址（必填）：用户在浏览器访问的 API 地址
# 本地开发: http://localhost:3001
# 服务器部署: https://api.xianlianth.com
NEXT_PUBLIC_API_BASE_URL=https://api.xianlianth.com

# JWT 签名密钥（必填）
AUTH_SECRET=your-secret-here

# 数据库（可选）
POSTGRES_USER=xiangtai
POSTGRES_PASSWORD=xiangtai_dev
POSTGRES_DB=xiangtai

# Redis（可选）
REDIS_PASSWORD=xiangtai_redis_dev

# AI（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/chat/completions
# 单次调用超时（毫秒，不填默认 12000）。
# 一条客户消息要串行调两次，前端单次请求 30 秒超时 —— 12+12 秒留 6 秒给数据库，
# 改大之前先想想前端那 30 秒。填了非正整数会被忽略并留一条 WARN。
DEEPSEEK_TIMEOUT_MS=12000

# AI 聊天的上限（都可不填，不填就用代码里的默认值）。
# ⚠️ 服务器部署复制的是根目录的 `env.example`（见 docs/deploy-china.md），不是这个文件。
#    这一组变量两个文件里都要有，改了记得两边同步。
# /client/ai/chat 每条消息固定调两次 DeepSeek，是唯一直接花钱的接口。
# 填了非正整数会被忽略、退回默认值，并在日志里留一条 WARN。
# ⚠️ 计数存在内存里，API 一重启就清零；上多进程要换成 Redis。
AI_CHAT_MAX_PER_MINUTE=10
AI_CHAT_MAX_PER_DAY=200
# 客户端「AI问答」输入框没有限字数，超长由后端按这个值挡（400 + 中文提示）
AI_CHAT_MAX_MESSAGE_CHARS=500

# ============ 客服对话的浏览器系统通知（可选；不填就不出现「开启通知」）============
# 2026-10-02：客户 / 员工在聊天页点「开启通知」后，没开系统页面也能在电脑右下角 / 手机通知栏收到新消息提醒。
# ⚠️ 服务器部署复制的是根目录的 `env.example`，这一组两边都要有，改了记得两边同步。
# 三项都要填才会开。公钥私钥是一对，在服务器上生成一次：
#   docker compose run --rm -T api npx web-push generate-vapid-keys
# ⚠️ 生成以后**别再换**：换了所有人已经开的通知全部失效，要重新点一次「开启通知」。
# ⚠️ 私钥只放在服务器的 .env 里，别提交到 Git、别发给别人。
# VAPID_SUBJECT 填 mailto:你的邮箱（各家推送服务出问题时联系用，必须 mailto: 或 https:// 开头）。
# 改完必须 `docker compose up -d`（重建容器）才会生效，docker-compose.yml 里已透传。
# 服务器要能连上各家推送服务（fcm.googleapis.com / web.push.apple.com / updates.push.services.mozilla.com）；
# 服务器在中国大陆的话谷歌那家连不上：Chrome / Edge 收不到，苹果、火狐不受影响。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
